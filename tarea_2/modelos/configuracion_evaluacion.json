   }
  },
  "faster-whisper large-v3-turbo": {
   "rol": "ASR de la Parte 1",
   "modelo": "mobiuslabsgmbh/faster-whisper-large-v3-turbo",
   "version": "1.2.1",
   "opciones": {
    "device": "cpu",
    "compute_type": "int8",
    "language": "es",
    "beam_size": 5,
    "vad_filter": true,
    "vad_parameters": {
     "min_silence_duration_ms": 300
    }
   },
   "origen": "salidas de 01_extraccion.ipynb (sección 4)"
  },
  "Qwen2.5-1.5B-Instruct": {
   "rol": "LLM de extracción",
   "modelo": "Qwen/Qwen2.5-1.5B-Instruct-GGUF (q4_k_m)",
